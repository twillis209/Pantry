# Host workflow test (criterion 3), remote variant: as tests/host/Snakefile,
# but both stages are fetched from GitHub at tag module-v0.1.9 with github().
# FUSION and gcta come from pheast's TWAS container image, so nothing binary is
# fetched (Snakemake's git source cache cannot fetch binary files; see
# tests/hpc/README.md, Tasks 14 and 19).
# Run from a run directory holding config.yaml (a copy of
# tests/host/config.yaml) and the input/ links it describes, with the host
# profile:
#   snakemake -s <repo>/tests/host/Snakefile.github --profile <repo>/tests/host/profile
# Targets: 'all' (every dataset of both stages) or 'tested' (phenotyping 'full'
# and pheast 'geuvadis', the run-time test; 'chained' is dry-run only).
from snakemake.utils import min_version

min_version("9.14")


configfile: "config.yaml"


pathvars:
    results="results",
    resources="resources",


module pantry_pheno:
    pathvars:
        pantry_output="<results>/pantry/phenotypes",
        pantry_intermediate="<results>/pantry/intermediate/phenotyping",
        pantry_reference="<resources>/pantry/reference",
    snakefile:
        github(
            "twillis209/Pantry",
            path="phenotyping/Snakefile",
            tag="module-v0.1.9",
        )
    config:
        config["pantry"]["phenotyping"]


use rule * from pantry_pheno as pantry_pheno_*


module pantry_pheast:
    pathvars:
        pantry_output="<results>/pantry/pheast",
        pantry_intermediate="<results>/pantry/intermediate/pheast",
        pantry_resources="<resources>/pantry",
    snakefile:
        github(
            "twillis209/Pantry",
            path="pheast/Snakefile",
            tag="module-v0.1.9",
        )
    config:
        config["pantry"]["pheast"]


use rule * from pantry_pheast as pantry_pheast_*


# Both modules' 'all' rules are default targets too; this one is defined last.
rule all:
    default_target: True
    input:
        rules.pantry_pheno_all.input,
        rules.pantry_pheast_all.input,


rule tested:
    """Datasets run in full by the host test: phenotyping 'full', pheast 'geuvadis'."""
    input:
        rules.pantry_pheno_all.input,
        [f for f in rules.pantry_pheast_all.input if "/geuvadis/" in f],
