from pathlib import Path
import pandas as pd
from snakemake.utils import min_version

min_version("9.12")


configfile: "config.yml"


# Output roots. A host workflow importing this one as a module can override them.
pathvars:
    pantry_output="output",
    pantry_intermediate="intermediate",
    pantry_resources="intermediate/resources",


wildcard_constraints:
    dataset="[^/]+",
    modality="[^/]+",
    chrom="[^/]+",
    batch="[^/]+",
    batch_start=r"\d+",
    batch_end=r"\d+",


# This code validates and processes the configuration and sets global variables:
include: "steps/setup.smk"


# These are the target files to be generated (or regenerated if outdated).
# By default it includes all output files of every dataset in the config file.
rule all:
    default_target: True
    input:
        [
            f"<pantry_output>/{name}/{f}"
            for name, d in CONFIG["datasets"].items()
            for f in pantry_config.dataset_targets(d)
        ],


rule check_genotype_samples:
    """Check that the dataset's samples are all in its genotypes."""
    input:
        fam=geno_fam,
    output:
        touch("<pantry_intermediate>/{dataset}/genotype_samples.ok"),
    localrule: True
    params:
        samples=lambda w: dataset_samples(w.dataset),
    run:
        pantry_config.check_genotype_samples(params.samples, input.fam)


checkpoint phenotype_summary:
    """Chromosomes and phenotype count of a modality's BED.

    Heritability batches by chromosome and TWAS batches by phenotype count
    are known only once the BED exists, so their inputs read this.
    """
    input:
        bed=pheno_bed,
    output:
        "<pantry_intermediate>/{dataset}/summary/{modality}.tsv",
    localrule: True
    run:
        pantry_config.write_phenotype_summary(input.bed, output[0])


# Every analysis's rules are loaded; each dataset's analyses decide its targets.
include: "steps/covariates.smk"
include: "steps/qtl.smk"
include: "steps/heritability.smk"
include: "steps/twas.smk"
