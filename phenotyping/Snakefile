## Additional general rules


rule index_bam:
    """Index a BAM file."""
    input:
        "<pantry_intermediate>/{dataset}/bam/{sample_id}.bam",
    output:
        "<pantry_intermediate>/{dataset}/bam/{sample_id}.bam.bai",
    threads: 8
    params:
        add_threads=lambda w, threads: threads - 1,
    shell:
        # It expects the number of *additional* threads to use beyond the first.
        "samtools index -@ {params.add_threads} {input}"


rule index_bed:
    """Index a BED file."""
    input:
        "<pantry_output>/{dataset}/{pheno}.bed.gz",
    output:
        "<pantry_output>/{dataset}/{pheno}.bed.gz.tbi",
    wildcard_constraints:
        # cross_modality.bed.gz.tbi is written by combine_modalities.
        pheno="(?!cross_modality\.bed)[^/]+",
    localrule: True
    shell:
        "tabix {input}"


rule write_samples:
    """Write the dataset's sample IDs, one per line, for scripts taking --samples."""
    output:
        "<pantry_intermediate>/{dataset}/samples.txt",
    localrule: True
    params:
        samples=lambda w: dataset_samples(w.dataset),
    run:
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        with open(output[0], "w") as out:
            out.write("".join(f"{sample_id}\n" for sample_id in params.samples))


rule validate_annotation:
    """Check that the reference annotation GTF contains transcript rows."""
    input:
        ref_anno=ref_file("annotation"),
    output:
        touch("<pantry_reference>/{reference}/annotation.ok"),
    localrule: True
    run:
        pantry_config.check_annotation(input.ref_anno)


rule extract_cdna:
    """Extract cDNA sequences from a genome and GTF file.

    Empty transcript_id fields, which appear in gene entries in some GTFs,
    results in 'Error: no valid ID found for GFF record', so they are removed
    before running gffread.
    """
    input:
        ref_genome=ref_file("genome"),
        ref_anno=ref_file("annotation"),
        anno_ok="<pantry_reference>/{reference}/annotation.ok",
    output:
        "<pantry_reference>/{reference}/cDNA.fa.gz",
    localrule: True
    shell:
        """
        sed '/transcript_id "";/d' {input.ref_anno} \
            | gffread -g {input.ref_genome} -w - - \
            | bgzip -c \
                >{output}
        """
